# H.O.L.M.E.V System Environment Configuration

# App Mode & Security
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
JWT_SECRET=holmev_production_super_secret_jwt_key_change_me_in_prod
SECRET_KEY=holmev_system_secret_key_3115

# Database Configuration
DATABASE_URL=sqlite+aiosqlite:///./holmev.db
REDIS_URL=redis://localhost:6379/0

# AI Provider Keys
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
DEFAULT_AI_PROVIDER=gemini
AI_FALLBACK_PROVIDER=openai

# Voice Engine Configuration
STT_PROVIDER=local
TTS_PROVIDER=local
CUSTOM_VOICE_PROVIDER=local
CUSTOM_VOICE_ID=holmev_voice_prime

# Smart Home & Hardware Adapters
HOME_DEVICE_MODE=SIMULATED
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
ESP32_GATEWAY_URL=http://192.168.1.100

# Desktop Agent Configuration
DESKTOP_AGENT_URL=http://localhost:8000
DESKTOP_AGENT_TOKEN=holmev_desktop_agent_secure_token

# Vision & Gesture
VISION_CAMERA_INDEX=0
GESTURE_ENABLED=true
