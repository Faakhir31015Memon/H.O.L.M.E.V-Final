# H.O.L.M.E.V backend — configuration
#
# Copy this file to backend/.env (the backend reads .env from its own folder):
#   Copy-Item .env.example backend\.env
#
# Every value below has a safe local-first default in
# backend/app/config/settings.py, so an empty file still boots. A blank setting
# here means "this hardware or service does not exist", and the brain REFUSES the
# matching action instead of reporting one it did not perform. Do not fill a
# setting to make a demo look successful.

# ---------------------------------------------------------------- app + security
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Replace both before this machine is reachable from anywhere but localhost.
JWT_SECRET=change_me_in_production
SECRET_KEY=change_me_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

API_HOST=127.0.0.1
API_PORT=8000
# Empty = only this machine may talk to the brain, and no header is checked.
# Set a long random string the moment anything else (phone app, LAN client)
# needs access; every endpoint then demands it. POST /api/v1/brain/stop is the
# one exception on purpose — the emergency stop must work without a credential.
API_TOKEN=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,tauri://localhost

# ------------------------------------------------------------------- persistence
DATABASE_URL=sqlite+aiosqlite:///./holmev.db
# File tools, undo snapshots and 3D exports cannot escape this directory.
WORKSPACE_ROOT=./workspace
UNDO_RETENTION_DAYS=7

# --------------------------------------------------------- local models (Ollama)
# The default brain. Install Ollama, then pull at least the chat model:
#   ollama pull qwen2.5:3b
# Verify with:  ollama list
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_DEFAULT_MODEL=qwen2.5:3b
OLLAMA_CHAT_MODEL=qwen2.5:3b
OLLAMA_CODER_MODEL=qwen2.5-coder:7b
OLLAMA_REASONING_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_S=120
OLLAMA_KEEP_ALIVE=5m
# Big ctx uses big RAM on a local run. Raise only if the machine can hold it.
OLLAMA_NUM_CTX=8192

# ------------------------------------------------------- external models (opt-in)
# OFF until BOTH a key exists and you allow it, and PRIVACY_LEVEL is not
# local_only. Never paste a key you did not obtain from your own account.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_PROVIDER_LABEL=openai
OPENAI_DEFAULT_MODEL=gpt-4o-mini
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
# Put the provider's published price here. 0.0 means "unknown", and the UI then
# says unknown — it never guesses and never calls a paid model free.
EXTERNAL_COST_PER_1K_INPUT_USD=0.0
EXTERNAL_COST_PER_1K_OUTPUT_USD=0.0

BRAIN_PRIMARY_PROVIDER=ollama
# Keep false unless you have read what leaves the device.
BRAIN_ALLOW_EXTERNAL=false

# ------------------------------------------------------------------- privacy
# local_only | allow_external_with_consent | allow_external
# The router will not send a private request to a remote model under local_only.
PRIVACY_LEVEL=local_only

# ------------------------------------------------ routing weights (all explainable)
W_CAPABILITY=3.0
W_CONTEXT=1.5
W_SPEED=1.0
W_PREFERENCE=1.0
W_COST=1.0
W_PRIVACY=2.0

# ------------------------------------------------------------ orchestration limits
MAX_STEPS_PER_RUN=12
MAX_PLAN_JSON_REPAIRS=2
STAGE_TIMEOUT_S=120
APPROVAL_EXPIRY_S=300
# Permission level at or above which an action needs your explicit yes.
APPROVAL_MIN_LEVEL=2
RATE_LIMIT_PER_MIN=60

# --------------------------------------------------------------------- memory
MEMORY_TOKEN_BUDGET=900
MEMORY_MAX_ROWS=2000
CONVERSATION_HISTORY_TURNS=8
CONTEXT_TOKEN_BUDGET=6000

# ------------------------------------------------------------ voice + vision
# Local STT/TTS really runs once the optional dependencies are installed:
#   pip install faster-whisper sounddevice numpy
# Until then the voice engines report that the dependency is missing rather
# than playing a recording of a canned answer.
STT_PROVIDER=local
TTS_PROVIDER=local
CUSTOM_VOICE_PROVIDER=local
CUSTOM_VOICE_ID=holmev_voice_prime
# Stays false until you choose to keep a microphone open. The brain never starts
# listening by itself.
WAKE_WORD_ENABLED=false

VISION_CAMERA_INDEX=0
GESTURE_ENABLED=false

# ------------------------------------------------------------- host control
# Deliberately false. Restarting or shutting the machine down is not something a
# model may do because a plan suggested it; a wrong one costs your unsaved work.
ALLOW_SYSTEM_POWER_ACTIONS=false

# ------------------------------------------------------------------ smart home
# SIMULATED = the registry tracks state honestly and says no appliance moved.
# Real hardware needs the MQTT broker / ESP32 gateway below and this set to MQTT.
HOME_DEVICE_MODE=SIMULATED
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
ESP32_GATEWAY_URL=http://192.168.1.100
# HTTP endpoint of a real IR emitter board. Empty = no emitter, and the IR engine
# stores the code instead of claiming it pulsed a lamp.
IR_GATEWAY_URL=
# JSON object of room -> stream URL. Rooms may be listed without a URL; those
# entries admit they have no feed. RTSP URLs are reported as NOT_PROBEABLE from
# here rather than guessed at. POST /api/v1/brain/cameras/probe is the only thing
# that can mark a feed ONLINE.
#   CAMERAS={"bedroom":"http://192.168.1.40:8080/video","hall":"rtsp://192.168.1.41/cam"}
CAMERAS=
CAMERA_PROBE_TIMEOUT_S=3.0

DESKTOP_AGENT_URL=http://localhost:8000
DESKTOP_AGENT_TOKEN=

# ----------------------------------------------------------- communication
# WhatsApp, dialling and the phone gallery need a companion app running on the
# phone (Tasker/Termux/an agent) reachable from this machine. Blank = nothing is
# paired, and those actions refuse and name this setting.
MOBILE_BRIDGE_URL=
MOBILE_BRIDGE_TOKEN=
# Email genuinely sends once these are filled — any SMTP server works, including
# a Gmail app password (Google Account > Security > App passwords) or a local
# server. Use an app password, not your real account password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_USE_TLS=true

# ---------------------------------------------------------------- navigation
# No map data means the route engine says "no map backend" instead of inventing a
# distance. Private local option (needs an OSRM .pbf extract for your region):
#   docker run -d -p 5000:5000 -v $PWD/maps:/data orosm/osrm-backend \
#     osrm-routed --algorithm mli /data/region.osrm
# The public demo server works too, but it sends your coordinates to someone
# else's machine — that is a privacy decision, not a convenience one.
OSRM_BASE_URL=
NOMINATIM_BASE_URL=
# Only used to answer "from my home" when no origin is given. 0.0 means unset.
HOME_LATITUDE=0.0
HOME_LONGITUDE=0.0

# --------------------------------------------------------------------- limits
MAX_UPLOAD_SIZE_MB=50
